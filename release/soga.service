[Unit]
Description=soga
Documentation=https://github.com/Miku-programm/soga-dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/soga
ExecStart=/usr/local/soga/soga -c /etc/soga/soga.conf -b /etc/soga/blockList -w /etc/soga/whiteList -d /etc/soga/dns.yml -r /etc/soga/routes.toml
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
